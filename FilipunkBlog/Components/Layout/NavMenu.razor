@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<header class="sticky top-0 z-50 border-b border-gray-800 bg-gray-950/90 backdrop-blur">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <a href="@($"{P}/")" class="font-mono text-lg font-bold text-white">
                filipunk<span class="text-blue-500">.cz</span>
            </a>
            <nav class="hidden items-center gap-8 text-sm sm:flex">
                @foreach (var link in NavLinks)
                {
                    <a class="text-gray-400 hover:text-white transition" href="@link.Href">@link.Label</a>
                }
            </nav>
            <div class="flex items-center gap-3">
                <LanguageSwitcher />
                <AuthorizeView>
                    <Authorized>
                        <a href="@($"{P}/admin")" class="hidden sm:block rounded font-mono text-xs px-3 py-1.5 bg-gray-800 text-white hover:bg-gray-700 transition">@L["Nav_Admin"]</a>
                        <a href="/Account/Logout" class="hidden sm:block rounded font-mono text-xs px-3 py-1.5 border border-gray-700 text-gray-400 hover:text-white transition">@L["Nav_Logout"]</a>
                    </Authorized>
                </AuthorizeView>
                <button @onclick="ToggleMenu" type="button"
                        aria-label="@(_menuOpen ? L["Nav_MenuClose"] : L["Nav_MenuOpen"])"
                        aria-expanded="@_menuOpen" aria-controls="mobile-nav"
                        class="sm:hidden rounded border border-gray-700 p-2 text-gray-400 hover:text-white transition">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        @if (_menuOpen)
                        {
                            <path d="M6 18L18 6M6 6l12 12" />
                        }
                        else
                        {
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        }
                    </svg>
                </button>
            </div>
        </div>

        @if (_menuOpen)
        {
            <div id="mobile-nav" class="border-t border-gray-800 py-4 sm:hidden">
                <nav class="flex flex-col gap-1">
                    @foreach (var link in NavLinks)
                    {
                        <a class="rounded px-3 py-2 text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition"
                           href="@link.Href" @onclick="CloseMenu">@link.Label</a>
                    }
                    <AuthorizeView>
                        <Authorized>
                            <a class="rounded px-3 py-2 text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition"
                               href="@($"{P}/admin")" @onclick="CloseMenu">@L["Nav_Admin"]</a>
                            <a class="rounded px-3 py-2 text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition"
                               href="/Account/Logout" @onclick="CloseMenu">@L["Nav_Logout"]</a>
                        </Authorized>
                    </AuthorizeView>
                </nav>
            </div>
        }
    </div>
</header>

@code {
    private bool _menuOpen = false;

    // Jazykový prefix aktuální stránky: "" (cs) nebo "/en".
    private string P => new Uri(Navigation.BaseUri).AbsolutePath.TrimEnd('/');

    private record NavLink(string Label, string Href);

    // Sekce úvodní stránky odkazujeme absolutně s prefixem, aby fungovaly i z jiných stránek.
    private NavLink[] NavLinks =>
    [
        new(L["Nav_Home"], $"{P}/"),
        new(L["Nav_About"], $"{P}/#about"),
        new(L["Nav_Projects"], $"{P}/#projects"),
        new(L["Nav_Experience"], $"{P}/#experience"),
        new(L["Nav_Blog"], $"{P}/#blog"),
        new(L["Nav_Gear"], $"{P}/setup"),
        new(L["Nav_Contact"], $"{P}/#kontakt"),
    ];

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
