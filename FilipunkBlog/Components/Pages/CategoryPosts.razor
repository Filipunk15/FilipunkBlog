@page "/category/{slug}"
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@inject IBlogPostService BlogPostService
@inject IStringLocalizer<SharedResource> L

<PageTitle>Filip Lafata – @_categoryName</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-12">
        <h1 class="font-mono text-3xl font-bold text-white">@_categoryName</h1>
    </div>

    @if (_posts.Count > 0)
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var post in _posts)
            {
                <a href="posts/@post.Slug" class="group flex flex-col rounded-lg border border-gray-700 bg-gray-900 overflow-hidden hover:border-blue-600/50 transition">
                    <div class="p-6">
                        <span class="text-xs text-gray-400">@post.PublishedAtDisplay</span>
                        <h2 class="font-mono text-sm font-bold text-white group-hover:text-blue-500 transition mt-2 mb-3">@post.Title</h2>
                        <p class="text-sm text-gray-400 leading-relaxed line-clamp-3">@post.Introduction</p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-gray-400 font-mono text-sm">@L["Category_NoPosts"]</p>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private List<BlogPostViewModel> _posts = [];
    private string _categoryName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _posts = await BlogPostService.GetPostsByCategoryAsync(Slug);
        _categoryName = _posts.FirstOrDefault()?.CategoryName ?? Slug;
    }
}