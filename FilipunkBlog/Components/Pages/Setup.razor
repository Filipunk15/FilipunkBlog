@page "/setup"
@using System.Linq

<PageTitle>Filip Lafata - Setup / EDC</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-12">
        <span class="inline-block mb-4 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // SETUP
        </span>
        <h1 class="font-mono text-3xl font-bold text-white">Můj stack</h1>
    </div>

    <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-12">
            @if (_edcItems.Count > 0)
            {
                <table class="w-full border-collapse font-mono text-sm">
                    <tbody>
                        @foreach (var group in GroupedItems)
                        {
                            
                            <tr class="bg-gray-800/50">
                                <td colspan="3" class="px-4 py-2 text-xs text-blue-500 uppercase tracking-widest border-b border-gray-700">
                                    @group.Key.ToString().Replace("_", " ")
                                </td>
                            </tr>

                            @foreach (var item in group)
                            {
                                <tr class="border-b border-gray-800 hover:bg-gray-900/50 transition">
                                    <td class="px-4 py-3 text-white font-bold whitespace-nowrap">
                                        @item.Item
                                    </td>
                                    <td class="px-4 py-3 text-gray-400 leading-relaxed">
                                        @item.Type
                                    </td>
                                    <td class="px-4 py-3 text-right whitespace-nowrap">
                                        <a href="@item.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="text-blue-500 hover:text-blue-400 transition">
                                            @item.UrlTitle.ToString()
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <small>Poslední update: @lastUpdateDate</small>
            }
            else
            {
                <p class="text-gray-500 font-mono text-sm">// zatím žádné položky</p>
            }
        </div>
    </div>
</div>

