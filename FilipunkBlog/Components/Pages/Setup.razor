@page "/setup"
@using System.Linq
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PageTitle_Setup"]</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-10 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="font-mono text-3xl font-bold text-white">@L["Setup_Title"]</h1>
            <p class="mt-3 max-w-xl text-sm text-gray-400 leading-relaxed">
                @L["Setup_Subtitle"]
            </p>
        </div>
        <span class="font-mono text-xs text-gray-400 border border-gray-800 rounded px-3 py-1.5 whitespace-nowrap">
            @L["Setup_LastUpdate"] @lastUpdateDate
        </span>
    </div>

    @if (_edcItems.Count > 0)
    {
        <div class="flex flex-col gap-16">
            @foreach (var group in GroupedItems)
            {
                <section id="@Anchor(group.Key)" class="scroll-mt-24">
                    <div class="mb-6 flex items-center gap-3 border-b border-gray-800 pb-3">
                        <span class="text-blue-500 text-lg"><i class="@CategoryIcon(group.Key)"></i></span>
                        <h2 class="font-mono text-sm font-bold text-white uppercase tracking-widest">
                            @CategoryName(group.Key)
                        </h2>
                        <span class="font-mono text-xs text-gray-500">@ItemCount(group.Count())</span>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        @foreach (var item in group)
                        {
                            <div class="flex flex-col rounded-lg border border-gray-700 bg-gray-950 p-5 hover:border-blue-600/50 transition">
                                <div class="font-mono text-xs text-blue-500 uppercase tracking-wider mb-1.5">
                                    @ItemLabel(item.Item)
                                </div>
                                <div class="text-sm font-bold text-white leading-snug mb-4">
                                    @item.Type
                                </div>
                                <a href="@item.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="@item.Type – @item.UrlTitle.ToString()"
                                   class="mt-auto inline-flex items-center gap-1.5 self-start font-mono text-xs px-2.5 py-1 rounded-sm bg-gray-800 text-gray-400 border border-gray-700 hover:text-blue-500 hover:border-blue-600/50 transition">
                                    @item.UrlTitle.ToString()
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <p class="text-gray-400 font-mono text-sm">@L["Setup_Empty"]</p>
    }
</div>

