    private string CategoryName(Category c) => c switch
    {
        Category.Setup => L["Setup_Cat_Setup"],
        Category.Práce => L["Setup_Cat_Work"],
        Category.Every_Day_Carry => L["Setup_Cat_EDC"],
        Category.Herní_PC => L["Setup_Cat_GamingPC"],
        Category.Software => L["Setup_Cat_Software"],
        _ => c.ToString().Replace("_", " "),
    };

    private static string Anchor(Category c) => c.ToString().Replace("_", "-").ToLowerInvariant();

    private string ItemCount(int n) => n switch
    {
        1 => L["Setup_Count_1"],
        >= 2 and <= 4 => L["Setup_Count_2_4", n],
        _ => L["Setup_Count_5", n],
    };

