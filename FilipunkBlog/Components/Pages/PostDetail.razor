@page "/posts/{slug}"
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@inject IBlogPostService BlogPostService
@inject NavigationManager Navigation
@inject ICommentService CommentService
@inject IMarkdownService Markdown
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>Filip Lafata – @(_post?.Title ?? "Post")</PageTitle>

<HeadContent>
    <meta name="description" content="@_post?.Introduction" />
    <meta property="og:title" content="@_post?.Title" />
    <meta property="og:description" content="@_post?.Introduction" />
    <meta property="og:image" content="@_post?.Image" />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (_post != null)
    {
        <link rel="alternate" hreflang="cs" href="@($"https://filipunk.cz/posts/{_post.SlugCs}")" />
        <link rel="alternate" hreflang="en" href="@($"https://filipunk.cz/en/posts/{_post.SlugEn ?? _post.SlugCs}")" />
        <link rel="alternate" hreflang="x-default" href="@($"https://filipunk.cz/posts/{_post.SlugCs}")" />
    }
</HeadContent>

@if (_post == null)
{
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
        <p class="font-mono text-gray-400 text-sm">@L["Common_Loading"]</p>
    </div>
}
else
{
    <article class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <a href="category/@_post.CategorySlug"
                       class="font-mono text-xs text-blue-500 bg-blue-600/10 px-2 py-0.5 rounded-sm hover:bg-blue-600/20 transition">
                    @_post.CategoryName
                </a>
                <span class="text-xs text-gray-400">@_post.PublishedAtDisplay</span>
                <span class="text-xs text-gray-400">@_post.ReadingTime @L["Common_Reading"]</span>
            </div>
            <h1 class="font-mono text-3xl font-bold text-white leading-tight mb-4">@_post.Title</h1>
            <p class="text-gray-400 text-lg leading-relaxed">@_post.Introduction</p>
        </div>

        @if (!string.IsNullOrEmpty(_post.Image))
        {
            <img src="@_post.Image" alt="@_post.Title" class="w-full rounded-lg mb-10 border border-gray-800" />
        }

        <div class="prose prose-invert prose-green max-w-none text-gray-300 leading-relaxed">
            @((MarkupString)Markdown.ToHtml(_post.Content))
        </div>

        @if (_post.Tags.Count > 0)
        {
            <div class="mt-12 pt-8 border-t border-gray-800">
                <div class="flex flex-wrap gap-2">
                    @foreach (var tag in _post.Tags)
                    {
                        <span class="font-mono text-xs px-3 py-1 bg-gray-800 text-gray-400 border border-gray-700 rounded-sm">@tag</span>
                    }
                </div>
            </div>
        }

        <div class="mt-10">
            <a href="posts" class="font-mono text-xs text-blue-500 hover:text-blue-400 transition">@L["PostDetail_BackBlog"]</a>
        </div>
    </article>

    <div class="mx-auto max-w-3xl px-6 lg:px-8 mt-16 pt-10 border-t border-gray-800">
        <h2 class="font-mono text-xs text-blue-500 uppercase tracking-widest mb-8">// @L["PostDetail_Comments"]</h2>

        @if (_comments.Count > 0)
        {
            <div class="flex flex-col gap-6 mb-12">
                @foreach (var comment in _comments)
                {
                    <div class="rounded-lg border border-gray-700 bg-gray-900 p-6">
                        <div class="flex items-center gap-3 mb-3">
                            <span class="font-mono text-sm font-bold text-white">@comment.Name</span>
                            <span class="text-xs text-gray-400">@comment.CreatedAtDisplay</span>
                        </div>
                        <p class="text-sm text-gray-400 leading-relaxed">@comment.Content</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-gray-400 text-sm mb-12">@L["PostDetail_NoComments"]</p>
        }

        <div class="rounded-lg border border-gray-700 bg-gray-900 p-6">
            <h3 class="font-mono text-xs text-blue-500 uppercase tracking-widest mb-6">@L["PostDetail_AddComment"]</h3>

            @if (_submitted)
            {
                <div class="rounded border border-blue-500/30 bg-blue-500/10 px-4 py-3">
                    <p class="font-mono text-xs text-blue-400">@L["PostDetail_CommentSubmitted"]</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    <div>
                        <label class="font-mono text-xs text-gray-400 uppercase tracking-wider mb-2 block">@L["PostDetail_CommentName"]</label>
                        <input @bind="_name" placeholder="@L["PostDetail_CommentNamePlaceholder"]"
                               class="w-full rounded border border-gray-700 bg-gray-950 px-4 py-3 text-sm text-white font-mono focus:border-blue-500/50 focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-mono text-xs text-gray-400 uppercase tracking-wider mb-2 block">@L["PostDetail_CommentText"]</label>
                        <textarea @bind="_content" rows="4" placeholder="@L["PostDetail_CommentPlaceholder"]"
                                  class="w-full rounded border border-gray-700 bg-gray-950 px-4 py-3 text-sm text-white font-mono focus:border-blue-500/50 focus:outline-none resize-none"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="font-mono text-xs text-red-400">@_error</p>
                    }
                    <button @onclick="SubmitComment"
                            class="rounded font-mono text-sm px-6 py-3 bg-blue-600/20 text-blue-500 border border-blue-600/40 hover:bg-blue-600/30 transition self-start">
                        @L["PostDetail_CommentSend"]
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private BlogPostViewModel? _post;

    private List<CommentViewModel> _comments = [];
    private string _name = string.Empty;
    private string _content = string.Empty;
    private string _error = string.Empty;
    private bool _submitted = false;


    protected override async Task OnInitializedAsync()
    {
        _post = await BlogPostService.GetPostBySlugAsync(Slug);
        if (_post == null)
        {
            Navigation.NavigateTo("posts");
            return;
        }
        await BlogPostService.IncrementViewsAsync(_post.Id);
        _comments = await CommentService.GetApprovedByPostAsync(_post.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_post != null)
            await JS.InvokeVoidAsync("blogEnhance");
    }

    private async Task SubmitComment()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_name)) { _error = L["PostDetail_ErrName"]; return; }
        if (string.IsNullOrWhiteSpace(_content)) { _error = L["PostDetail_ErrText"]; return; }
        if (_content.Length > 1000) { _error = L["PostDetail_ErrTooLong"]; return; }

        try
        {
            await CommentService.AddAsync(_post!.Id, _name, _content);
            _submitted = true;
        }
        catch (Exception ex)
        {
            _error = L["Admin_SaveError", ex.Message];
        }
    }
}