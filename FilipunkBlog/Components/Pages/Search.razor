@page "/search"
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@inject IBlogPostService BlogPostService
@inject NavigationManager Navigation

<PageTitle>Hledání — Filip</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-12">
        <span class="inline-block mb-4 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // HLEDÁNÍ
        </span>
        <div class="flex gap-4 mt-6">
            <input @bind="_query" @bind:event="oninput" @onkeyup="OnKeyUp"
                   placeholder="Hledat příspěvky..."
                   class="flex-1 rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none" />
            <button @onclick="DoSearch"
                    class="rounded font-mono text-sm px-6 py-3 bg-blue-600/20 text-blue-500 border border-blue-600/40 hover:bg-blue-600/30 transition">
                Hledat →
            </button>
        </div>
    </div>

    @if (_searched)
    {
        @if (_results.Count > 0)
        {
            <div class="flex flex-col divide-y divide-gray-800">
                @foreach (var post in _results)
                {
                    <a href="/posts/@post.Slug" class="group flex items-center justify-between gap-6 py-6 hover:pl-4 transition-all">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <span class="font-mono text-xs text-blue-500 bg-blue-600/10 px-2 py-0.5 rounded-sm">@post.CategoryName</span>
                                <span class="text-xs text-gray-500">@post.PublishedAtDisplay</span>
                            </div>
                            <h3 class="font-mono text-sm font-bold text-white group-hover:text-blue-500 transition">@post.Title</h3>
                            <p class="text-xs text-gray-500 mt-1 line-clamp-2">@post.Introduction</p>
                        </div>
                        <span class="text-xs text-gray-500 whitespace-nowrap">@post.ReadingTime čtení</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="font-mono text-sm text-gray-500">// žádné výsledky pro "@_query"</p>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }

    private string _query = string.Empty;
    private List<BlogPostViewModel> _results = [];
    private bool _searched = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Q))
        {
            _query = Q;
            await DoSearch();
        }
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }

    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _results = await BlogPostService.SearchAsync(_query);
        _searched = true;
    }
}