@page "/projects"
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@inject IProjectService ProjectService
@inject ITagService TagService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PageTitle_Projects"]</PageTitle>

<HeadContent>
    <meta name="description" content="@L["Projects_Title"]" />
    <meta property="og:title" content="@L["PageTitle_Projects"]" />
</HeadContent>

<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-12">
        <h1 class="font-mono text-3xl font-bold text-white">@L["Projects_Title"]</h1>
    </div>

    <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-8">
            @if (_projects.Items.Count > 0)
            {
                <div class="grid gap-6 sm:grid-cols-2">
                    @foreach (var p in _projects.Items)
                    {
                        <a href="project/@p.Slug" class="group flex flex-col rounded-lg border border-gray-700 bg-gray-950 overflow-hidden hover:border-blue-600/50 transition">
                            @if (!string.IsNullOrEmpty(p.MainImage))
                            {
                                <img src="@p.MainImage" alt="@p.Title" class="w-full aspect-video object-cover" />
                            }
                            else
                            {
                                <div class="w-full aspect-video bg-gray-800 flex items-center justify-center">
                                    <span class="font-mono text-gray-600 text-xs">@L["Common_NoImage"]</span>
                                </div>
                            }
                            <div class="p-6 flex flex-col flex-1">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="font-mono text-xs text-blue-500">@p.YearDisplay</span>
                                    @if (p.IsFeatured)
                                    {
                                        <span class="font-mono text-xs text-amber-400">@L["Projects_Featured"]</span>
                                    }
                                </div>
                                <h2 class="font-mono text-sm font-bold text-white group-hover:text-blue-500 transition mb-3">@p.Title</h2>
                                <p class="text-sm text-gray-400 leading-relaxed line-clamp-3 flex-1">@p.Description</p>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    @foreach (var tag in p.Tags)
                                    {
                                        <span class="font-mono text-xs px-2 py-0.5 bg-gray-800 text-gray-400 border border-gray-700 rounded-sm">@tag</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @if (_projects.TotalPages > 1)
                {
                    <div class="mt-12 flex items-center justify-center gap-3">
                        @if (_projects.HasPreviousPage)
                        {
                            <button @onclick="() => LoadPage(_currentPage - 1)"
                                    class="font-mono text-xs px-4 py-2 border border-gray-700 text-gray-400 hover:border-blue-600/50 hover:text-blue-500 transition rounded">
                                @L["Common_Prev"]
                            </button>
                        }
                        <span class="font-mono text-xs text-gray-400">@_currentPage / @_projects.TotalPages</span>
                        @if (_projects.HasNextPage)
                        {
                            <button @onclick="() => LoadPage(_currentPage + 1)"
                                    class="font-mono text-xs px-4 py-2 border border-gray-700 text-gray-400 hover:border-blue-600/50 hover:text-blue-500 transition rounded">
                                @L["Common_Next"]
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-gray-400 font-mono text-sm">@L["Projects_NoProjects"]</p>
            }
        </div>
    </div>
</div>

@code {
    private PagedResult<ProjectViewModel> _projects = new();
    private List<TagViewModel> _tags = [];
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
        _tags = await TagService.GetTagsAsync();
    }

    private async Task LoadPage(int page)
    {
        _currentPage = page;
        _projects = await ProjectService.GetProjectsAsync(page, 9);
    }
}