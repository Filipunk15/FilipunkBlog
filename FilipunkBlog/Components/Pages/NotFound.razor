@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<div class="mx-auto max-w-3xl px-6 py-24 lg:px-8 text-center">
    <div class="font-mono text-7xl font-bold text-blue-500 mb-4">404</div>
    <h1 class="font-mono text-xl font-bold text-white mb-3">@L["NotFound_Title"]</h1>
    <p class="text-gray-400 text-sm mb-8">@L["NotFound_Text"]</p>
    <a href="." class="rounded font-mono text-sm px-6 py-3 bg-blue-600/20 text-blue-500 border border-blue-600/40 hover:bg-blue-600/30 transition">
        @L["Common_BackHome"]
    </a>
</div>
