@page "/admin/posts/new"
@page "/admin/posts/edit/{id:guid}"
@attribute [Authorize(Roles = "Admin")]
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@using Microsoft.AspNetCore.Authorization
@inject IBlogPostService BlogPostService
@inject ICategoryService CategoryService
@inject IImageService ImageService
@inject ITagService TagAdminService
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Nový příspěvek" : "Upravit příspěvek")</PageTitle>

<div class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
    <div class="mb-12">
        <span class="inline-block mb-4 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // ADMIN
        </span>
        <h1 class="font-mono text-3xl font-bold text-white">@(_isNew ? "Nový příspěvek" : "Upravit příspěvek")</h1>
    </div>

    <div class="flex flex-col gap-6">
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Titulek</label>
            <input @bind="_post.Title" @bind:event="oninput" @onchange="GenerateSlug"
                   class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none" />
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Slug</label>
            <input @bind="_post.Slug"
                   class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none" />
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Kategorie</label>
            <select @bind="_post.CategoryId"
                    class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none">
                @foreach (var cat in _categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Tagy</label>
            <div class="flex flex-wrap gap-2">
                @foreach (var tag in _allTags)
                {
                    var isSelected = _selectedTagIds.Contains(tag.Id);
                    <button type="button" @onclick="() => ToggleTag(tag.Id)"
                            class="font-mono text-xs px-3 py-1.5 rounded-sm border transition @(isSelected ? "border-blue-600/50 bg-blue-600/20 text-blue-500" : "border-gray-700 bg-gray-800 text-gray-400 hover:border-blue-600/30")">
                        @tag.Name
                    </button>
                }
            </div>
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Úvod</label>
            <textarea @bind="_post.Introduction" rows="3"
                      class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none resize-none"></textarea>
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Obsah (HTML)</label>
            <textarea @bind="_post.Content" rows="15"
                      class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-white font-mono focus:border-blue-600/50 focus:outline-none resize-y"></textarea>
        </div>
        <div>
            <label class="font-mono text-xs text-gray-500 uppercase tracking-wider mb-2 block">Obrázek</label>
            @if (!string.IsNullOrEmpty(_post.Image))
            {
                <div class="mb-3">
                    <img src="@_post.Image" class="h-32 rounded border border-gray-700 object-cover" />
                    <button @onclick="RemoveImage" class="mt-2 font-mono text-xs text-red-400 hover:text-red-300 transition">× Odebrat</button>
                </div>
            }
            <InputFile OnChange="UploadImage" accept="image/*"
                       class="w-full rounded border border-gray-700 bg-gray-900 px-4 py-3 text-sm text-gray-400 font-mono file:mr-4 file:rounded file:border-0 file:bg-blue-600/20 file:px-3 file:py-1 file:font-mono file:text-xs file:text-blue-500 cursor-pointer" />
            @if (_uploading)
            {
                <p class="font-mono text-xs text-gray-500 mt-2">// nahrávám...</p>
            }
        </div>
        <div class="flex items-center gap-3">
            <input type="checkbox" @bind="_post.IsPublished" id="published" class="rounded border-gray-700" />
            <label for="published" class="font-mono text-xs text-gray-400">Publikovat</label>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="font-mono text-xs text-red-400">@_error</p>
        }

        <div class="flex gap-4">
            <button @onclick="Save"
                    class="rounded font-mono text-sm px-6 py-3 bg-blue-600/20 text-blue-500 border border-blue-600/40 hover:bg-blue-600/30 transition">
                @(_isNew ? "Vytvořit" : "Uložit")
            </button>
            <a href="/admin/posts"
                   class="rounded font-mono text-sm px-6 py-3 border border-gray-700 text-gray-400 hover:border-gray-500 transition">
                Zrušit
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private BlogPostViewModel _post = new();
    private List<CategoryViewModel> _categories = [];
    private bool _isNew => Id == null;
    private string _error = string.Empty;

    private bool _uploading = false;

    private List<TagViewModel> _allTags = [];
    private List<Guid> _selectedTagIds = [];

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetCategoriesAsync();
        _allTags = await TagAdminService.GetTagsAsync();
        if (!_isNew)
        {
            var existing = await BlogPostService.GetAllPostsAsync();
            var found = existing.FirstOrDefault(x => x.Id == Id);
            _selectedTagIds = _post.TagIds;
            if (found != null) _post = found;
        }
        if (_categories.Count > 0 && _post.CategoryId == Guid.Empty)
            _post.CategoryId = _categories.First().Id;
    }

    private void GenerateSlug()
    {
        if (_isNew)
            _post.Slug = _post.Title.ToLower()
                .Replace(" ", "-")
                .Replace("á", "a").Replace("č", "c").Replace("ď", "d")
                .Replace("é", "e").Replace("ě", "e").Replace("í", "i")
                .Replace("ň", "n").Replace("ó", "o").Replace("ř", "r")
                .Replace("š", "s").Replace("ť", "t").Replace("ú", "u")
                .Replace("ů", "u").Replace("ý", "y").Replace("ž", "z");
    }

    private async Task Save()
    {
        if (string.IsNullOrEmpty(_post.Title)) { _error = "Titulek je povinný."; return; }
        if (string.IsNullOrEmpty(_post.Slug)) { _error = "Slug je povinný."; return; }
        if (_post.CategoryId == Guid.Empty) { _error = "Vyber kategorii."; return; }

        _post.TagIds = _selectedTagIds;

        if (_isNew) await BlogPostService.CreatePostAsync(_post);
        else await BlogPostService.UpdatePostAsync(_post);

        Navigation.NavigateTo("/admin/posts");
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        _uploading = true;
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        _post.Image = await ImageService.UploadAsync(stream, file.Name);
        _uploading = false;
    }

    private void ToggleTag(Guid id)
    {
        if (_selectedTagIds.Contains(id)) _selectedTagIds.Remove(id);
        else _selectedTagIds.Add(id);
    }

    private void RemoveImage() => _post.Image = null;
}