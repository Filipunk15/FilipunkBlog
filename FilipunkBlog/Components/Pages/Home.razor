@page "/"
@using FilipunkBlog.Application.Contracts
@using FilipunkBlog.Application.Models
@inject IBlogPostService BlogPostService
@inject IProjectService ProjectService  

<PageTitle>Filip Lafata - Osobní portfolio</PageTitle>

<HeadContent>
    <meta name="description" content="Filip — Junior .NET Developer. Portfolio a blog o C# a .NET vývoji." />
    <meta property="og:title" content="Filip Lafata - Osobní portfolio" />
    <meta property="og:description" content="Portfolio a blog o C# a .NET vývoji." />
    <meta property="og:type" content="website" />
</HeadContent>

<!-- HERO -->
<section class="bg-gray-950 border-b border-gray-800">
    <div class="mx-auto max-w-7xl px-6 py-32 lg:px-8">
        <div class="max-w-3xl">
            <span class="inline-block mb-6 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
                // hello world
            </span>
            <h1 class="font-mono text-5xl font-bold leading-tight tracking-tight text-white lg:text-7xl mb-6">
                Jsem Filip,<br />
                <span class="text-blue-500">juniorní vývojář</span>
            </h1>
            <p class="text-lg text-gray-400 leading-relaxed max-w-xl mb-10">
                Pracuji v C# a .NET na firemních interních aplikacích. Zajímám se o to, jak věci fungují uvnitř a postupně se zlepšuji.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="#projects" class="rounded font-mono text-sm font-bold px-7 py-3 bg-blue-600/20 text-blue-500 border border-blue-600/40 hover:bg-blue-600/30 transition">
                    Moje projekty →
                </a>
                <a href="#kontakt" class="rounded font-mono text-sm px-7 py-3 border border-gray-700 text-gray-300 hover:border-gray-500 transition">
                    Kontakt
                </a>
            </div>
        </div>
        <div class="mt-20 flex gap-12">
            @foreach (var stat in new[] { ("6+", "Projekty"), ("2+", "Roky komerční praxe")})
            {
                <div>
                    <div class="font-mono text-4xl font-bold text-white">@stat.Item1</div>
                    <div class="mt-1 text-sm text-gray-500">@stat.Item2</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- O MNĚ -->
<section id="about" class="bg-gray-950 border-b border-gray-800">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="grid gap-20 lg:grid-cols-2 items-start">
            <div>
                <span class="inline-block mb-6 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
                    // O MNĚ
                </span>
                <p class="text-gray-400 leading-relaxed text-base mb-4">
                    K programování jsem se dostal již na základní škole, kdy jsem s kamarády tvořil svoje Minecraft servery s vlastními pluginy, na střední škole jsme Minecraft vyměnili za FiveM modifikaci do GTA V, kde jsme si upravovali vlastní LUA scripty.
                </p>
                <p class="text-gray-400 leading-relaxed text-base">
                    Nyní se věnuji čistě C# programování, nejčastěji webovému vývoji a vývoji interních aplikací.
                </p>
            </div>
            <div class="flex flex-col">
                @foreach (var item in new[] {
                    ("Zaměření", ".NET / C# "),
                    ("Databáze", "MSSQL, MySQL"),
                    ("Frontend", "HTML, CSS, JavaScript"),
                    ("Nástroje", "Git, Visual Studio, Visual Studio Code, Notion, Jira"),
                    ("Jazyk", "Čeština, Angličtina")
                })
                {
                    <div class="flex justify-between py-3 border-b border-gray-800">
                        <span class="font-mono text-xs text-gray-500 uppercase tracking-wider shrink-0">@item.Item1</span>
                        <span class="text-sm text-white font-medium text-right ml-4">@item.Item2</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- PROJEKTY -->
<section id="projects" class="bg-gray-900 border-b border-gray-800">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="flex items-end justify-between mb-12">
            <span class="inline-block rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
                // PROJEKTY
            </span>
            <div class="flex items-center gap-3">
                @if (_isAdmin)
                {
                    <a href="/admin/projects/new" class="font-mono text-xs px-3 py-1.5 bg-blue-600/20 text-blue-500 border border-blue-600/40 rounded hover:bg-blue-600/30 transition">
                        + Přidat projekt
                    </a>
                }
                @if (_projects.Count() <= 0)
                {
                    <a href="/projects" class="font-mono text-xs text-blue-500 hover:text-blue-400 transition">Všechny projekty →</a>
                }
            </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
                @foreach (var p in _projects)
                {
                    <a href="/project/@p.Slug" class="rounded-lg border border-gray-700 bg-gray-950 p-8 hover:border-blue-600/50 transition cursor-pointer group block">
                            <div class="flex justify-between items-start mb-4">
                                <span class="font-mono text-xs text-blue-500">@p.YearDisplay</span>
                                <div class="flex items-center gap-2">
                                @if (_isAdmin)
                                {
                                    <a href="/admin/projects/edit/@p.Id" @onclick:stopPropagation="true" class="font-mono text-xs px-2 py-0.5 border border-gray-700 text-gray-500 hover:border-blue-600/50 hover:text-blue-500 transition rounded">
                                        ✎
                                    </a>
                                }
            <span class="font-mono text-xs text-gray-500 group-hover:text-blue-500 transition">detail ↗</span>
        </div>
    </div>
                        <h3 class="font-mono text-base font-bold text-white mb-3">@p.Title</h3>
                        <p class="text-sm text-gray-400 leading-relaxed mb-5">@p.Description</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var tag in p.Tags)
                            {
                                <span class="font-mono text-xs px-3 py-1 rounded-sm bg-gray-800 text-gray-400 border border-gray-700">@tag</span>
                            }
                        </div>
                    </a>
                }
        </div>
    </div>
</section>


<!-- TECHNOLOGIE -->
<section id="skills" class="bg-gray-950 border-b border-gray-800">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <span class="inline-block mb-12 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // TECHNOLOGIE
        </span>
        <div class="grid gap-10 grid-cols-2 lg:grid-cols-4">
            @foreach (var group in _skillGroups)
            {
                <div>
                    <div class="font-mono text-xs text-blue-500 uppercase tracking-widest mb-4">@group.Group</div>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var item in group.Items)
                        {
                            <span class="font-mono text-xs px-3 py-1.5 bg-gray-800 text-white border border-gray-700 rounded-sm break-all">@item</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ZKUŠENOSTI -->
<section class="bg-gray-900 border-b border-gray-800">
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
        <span class="inline-block mb-12 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // ZKUŠENOSTI
        </span>
        <div class="relative pl-8 border-l border-gray-700">
            @foreach (var (item, i) in _timeline.Select((t, i) => (t, i)))
            {
                <div class="relative @(i < _timeline.Count - 1 ? "mb-10" : "")">
                    <div class="absolute -left-[37px] top-1.5 h-3 w-3 rounded-full bg-blue-500 border-2 border-gray-900"></div>
                    <div class="font-mono text-xs text-blue-500 mb-1">@item.Year</div>
                    <h3 class="font-mono text-sm font-bold text-white">@item.Role</h3>
                    <div class="text-xs text-gray-500 mb-2">@item.Company</div>
                    <p class="text-sm text-gray-400 leading-relaxed" style="white-space: pre-line">@item.Desc</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- BLOG -->
<section id="blog" class="bg-gray-950 border-b border-gray-800">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="flex items-end justify-between mb-12">
            <span class="inline-block rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
                // BLOG
            </span>
            <div class="flex items-center gap-3">
                @if (_isAdmin)
                {
                    <a href="/admin/posts/new" class="font-mono text-xs px-3 py-1.5 bg-blue-600/20 text-blue-500 border border-blue-600/40 rounded hover:bg-blue-600/30 transition">
                        + Nový článek
                    </a>
                }
                @if (_recentPosts.Count > 0){
                    <a href="/posts" class="font-mono text-xs text-blue-500 hover:text-blue-400 transition">Všechny články →</a>
                }
            </div>
        </div>
        <div class="flex flex-col divide-y divide-gray-800">
            @if (_recentPosts.Count > 0)
            {
                @foreach (var post in _recentPosts)
                {
                    <a href="/posts/@post.Slug" class="group flex items-center justify-between gap-6 py-6 hover:pl-4 transition-all">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <span class="font-mono text-xs text-blue-500 bg-blue-600/10 px-2 py-0.5 rounded-sm">@post.CategoryName</span>
                                <span class="text-xs text-gray-500">@post.PublishedAtDisplay</span>
                            </div>
                            <h3 class="font-mono text-sm font-bold text-white group-hover:text-blue-500 transition">@post.Title</h3>
                        </div>
                        <span class="text-xs text-gray-500 whitespace-nowrap">@post.ReadingTime čtení</span>
                    </a>
                }
            }
            else
            {
                <p class="text-gray-500 text-sm py-6">Zatím žádné příspěvky.</p>
            }
        </div>
    </div>
</section>

<!-- KONTAKT -->
<section id="kontakt" class="bg-gray-900">
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
        <span class="inline-block mb-4 rounded-sm border border-blue-600/40 bg-blue-600/10 px-3 py-1 font-mono text-xs text-blue-500 tracking-widest uppercase">
            // KONTAKT
        </span>
        <p class="text-gray-400 text-sm leading-relaxed mb-12">
            Neváhejte mě kontaktovat ohledně nabídky práce, nabídce spolupráce, s dotazy.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
            <a href="https://www.github.com/filipunk15" target="_blank"
                   class="flex items-center gap-5 rounded-lg border border-gray-700 bg-gray-950 px-6 py-5 hover:border-blue-600/50 transition group">
                <span class="text-gray-500 group-hover:text-blue-500 transition font-mono text-lg"><i class="fa-brands fa-github"></i></span>
                <div>
                    <div class="font-mono text-sm font-bold text-white">GitHub</div>
                    <div class="text-xs text-gray-500">Zdrojové kódy projektů</div>
                </div>
                <span class="ml-auto text-gray-700 group-hover:text-blue-500 transition font-mono">↗</span>
            </a>
            <a href="https://www.linkedin.com/in/filip-lafata/" target="_blank"
                   class="flex items-center gap-5 rounded-lg border border-gray-700 bg-gray-950 px-6 py-5 hover:border-blue-600/50 transition group">
                <span class="text-gray-500 group-hover:text-blue-500 transition font-mono text-lg"><i class="fa-brands fa-square-linkedin"></i></span>
                <div>
                    <div class="font-mono text-sm font-bold text-white">LinkedIn</div>
                    <div class="text-xs text-gray-500">Profesní profil</div>
                </div>
                <span class="ml-auto text-gray-700 group-hover:text-blue-500 transition font-mono">↗</span>
            </a>
            <a href="mailto:f.lafata@filipunk.cz"
                   class="flex items-center gap-5 rounded-lg border border-gray-700 bg-gray-950 px-6 py-5 hover:border-blue-600/50 transition group">
                <span class="text-gray-500 group-hover:text-blue-500 transition font-mono text-lg">
                    <i class="fa-solid fa-at"></i>
                </span>
                <div>
                    <div class="font-mono text-sm font-bold text-white">E-mail</div>
                    <div class="text-xs text-gray-500">Přímý kontakt</div>
                    <div class="font-mono text-xs text-blue-500 mt-1">f.lafata@filipunk.cz</div>
                </div>
                <span class="ml-auto text-gray-700 group-hover:text-blue-500 transition font-mono">↗</span>
            </a>
            <a href="https://www.instagram.com/filiplafata/"
               class="flex items-center gap-5 rounded-lg border border-gray-700 bg-gray-950 px-6 py-5 hover:border-blue-600/50 transition group">
                <span class="text-gray-500 group-hover:text-blue-500 transition font-mono text-lg"><i class="fa-brands fa-instagram"></i></span>
                <div>
                    <div class="font-mono text-sm font-bold text-white">Instagram</div>
                    <div class="text-xs text-gray-500">Osobní profil</div>
                </div>
                <span class="ml-auto text-gray-700 group-hover:text-blue-500 transition font-mono">↗</span>
            </a>
        </div>
    </div>
</section>

@code {
    private List<BlogPostViewModel> _recentPosts = [];
    private List<ProjectViewModel> _projects = [];

    private int maxProjects = 3;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _recentPosts = await BlogPostService.GetRecentPostsAsync(3);
        PagedResult<ProjectViewModel> pagedResult = await ProjectService.GetProjectsAsync(1, maxProjects);
        _projects = pagedResult.Items;

        if (AuthState != null)
        {
            var auth = await AuthState;
            _isAdmin = auth.User.IsInRole("Admin");
        }
    }

    record SkillGroup(string Group, string[] Items);
    record TimelineItem(string Year, string Role, string Company, string Desc);

    private readonly List<SkillGroup> _skillGroups =
    [
        new("Backend", ["C#", ".NET", "MSSQL", "MYSQL", "REST API", "BLAZOR"]),
        new("Frontend", ["HTML", "CSS", "JAVASCRIPT", "BOOTSTRAP"]),
        new("Nástroje", ["Git", "Visual Studio", "Microsoft SQL Server", "Heidi SQL", "Unity", "Godot"]),
        new("Koncepty", ["OOP", "MVC", "CRUD", "Debugging"]),
    ];

    private readonly List<TimelineItem> _timeline =
    [
        new("2024–nyní", "IT Technik - Vývojář interních aplikací", "KDK Automotive Czech", "Programování interních aplikacích v jazycích C# (Blazor, MAUI) nebo Javascript (Node.js). \r\n Práce s databází Microsoft SQL, Informix, Oracle. Práce s Microsoft Azure, Microsoft Office. \r\n Zpracovávání dat z MES systému a ERP systému"),
        new("2023", "IT Stáž", "SUSPA CZ", "Programování maker v Microsoft Exce, Instalace síťové infrastruktury a příprava kabelových rozvodů pro nové kanceláře. \r\n Instalace a konfigurace čteček čárových kódů, tvorba a správa systémů pro generování čárových kódu"),
        new("2019-2023", "SPŠ Tachov, Světce 1", "Střední vzdělání s maturitou (Obor: Informační technologie)", "Programování a vývoj aplikací v Javě, instalace a správa operačních systémů, systémů i aplikačního programového vybavení"),
    ];
}